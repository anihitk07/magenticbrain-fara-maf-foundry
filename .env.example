PLANNER_SCORING_URI=https://<planner-endpoint>/v1/chat/completions
PLANNER_API_KEY=<planner-endpoint-key>
PLANNER_MODEL=MagenticBrain-14B

BROWSER_SCORING_URI=https://<browser-endpoint>/v1/chat/completions
BROWSER_API_KEY=<browser-endpoint-key>
BROWSER_MODEL=Fara1.5-9B
BROWSER_MODE=cua
BROWSER_CUA_MAX_STEPS=4
BROWSER_HEADLESS=true
BROWSER_ACTION_TIMEOUT_MS=12000
BROWSER_TASK_TIMEOUT_SECONDS=900
WEBWRIGHT_STEP_LIMIT=100
WEBWRIGHT_REQUIRE_SELF_REFLECTION=true

REPORTER_SCORING_URI=https://<reporter-endpoint>/v1/chat/completions
REPORTER_API_KEY=<reporter-endpoint-key>
REPORTER_MODEL=MagenticBrain-14B

REPORT_OUTPUT_DIR=reports
